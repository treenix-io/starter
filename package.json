{
  "name": "treenix-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --import tsx --conditions=development node_modules/vite/bin/vite.js --configLoader native",
    "clean": "rm -rf node_modules/.vite",
    "build": "node --import tsx --conditions=development node_modules/vite/bin/vite.js build --configLoader native",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.79",
    "@treenx/core": "file:../core/engine/core",
    "@treenx/mods": "file:../core/engine/mods",
    "@treenx/react": "file:../core/engine/packages/react",
    "@treenx/ssr": "file:../core/engine/packages/ssr"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "8.0.12"
  },
  "version": "0.0.1"
}
